%YAML 1.2
---
# http://www.sublimetext.com/docs/syntax.html
name: D
scope: source.d

file_extensions: [d, di]

first_line_match: |-
  (?xi:
    ^ \#! .*                                     # shebang
  | ^ \s* // .*? -\*- .*? \bd(lang)?\b .*? -\*-  # editorconfig
  )

variables:
  identifier: '[_[:alpha:]][_[:alnum:]]*'
  #name_lookahead: '(?=\b{{identifier}}\b)'
  #qualified_identifier: '\.?\s*{{identifier}}(\s*\.\s*{{identifier}})*'
  string_postfix: '[cwd]?'
  escape_sequence: '\\([''"?\\0abfnrtv]|x\h{2}|[0-7]{1,3}|u\h{4}|U\h{8}|&\w+;)'
  
  #integers
  integer_suffix: 'L[uU]|[uU]L|[LuU]'
  decimal_integer: '[1-9][\d_]*|0_*'
  binary_prefix: '0[bB]'
  binary_digits_no_single_us: '[01_]*[01][01_]*'
  binary_integer: '({{binary_prefix}})({{binary_digits_no_single_us}})'
  hex_prefix: '0[xX]'
  hex_digits_no_single_us: '[\h_]*\h[\h_]*'
  hexadecimal_integer: '({{hex_prefix}})({{hex_digits_no_single_us}})'
  integer: '(?:({{decimal_integer}})|{{binary_integer}}|{{hexadecimal_integer}})'
  integer_literal: '{{integer}}({{integer_suffix}})?'
  
  decimal_digits_no_single_us: '[\d_]*\d[\d_]*'
  
  #floats
  leading_decimal: '(?:{{decimal_integer}}|0{{decimal_digits_no_single_us}})'
  decimal_exponent: '[eE][+\-]?{{decimal_digits_no_single_us}}'
  hex_exponent:     '[pP][+\-]?{{decimal_digits_no_single_us}}'
  float_suffix: '[fF]'
  float_literal_suffix: '[fFL]'
  
  #character_lookahead: (?=')
  #string_lookahead: '(?=`|[rxq]?"|q{)'
  
  #definitely_value_lookahead: '(?=!|~|\+|\-|\*|&|\bcast\b|\bdelete\b|\bnew\b|\bimport\b|\bis\b|\b__traits\b|\bfunction\b|\bdelegate\b|[0-9]|\[|\(|{{string_lookahead}}|\b({{language_constant}})\b|\b({{language_variable}})\b)'
  #definitely_declaration_lookahead: '(?=(?:{{identifier}}\.)*{{identifier}}(\s+|\s*\*+\s*|\**\[.*\]\s*){{identifier}}|\b({{type_qualifier}})\b)'
  
  #type_qualifier: 'const|immutable|inout|shared'
  #type_qualifier_lookahead: '(?=\b({{type_qualifier}})\b)'
  #attribute_lookahead: '(?=@|\b({{attributes}}|extern|align|deprecated|pragma|private|protected|public|export|package)\b)'
  #attributes: 'static|abstract|final|override|synchronized|scope|__gshared|nothrow|pure|ref|return|auto'
  #at_attributes: 'disable|nogc|property|safe|system|trusted'
  #function_attribute_lookahead: '{{attribute_lookahead}}|{{type_qualifier_lookahead}}'
  #parameter_attribute_lookahead: '(?=\b({{parameter_attribute}})\b)'
  #parameter_attribute: 'in|lazy|out|alias'
  
  #construction_lookahead: '(?=~?\s*this\s*\()'
  
  keyword: 'else|enum|export|extern|debug|default|delegate|delete|deprecated|do|body|break|case|cast|catch|class|const|continue|abstract|alias|align|asm|assert|auto|final|finally|for|foreach|foreach_reverse|function|goto|if|immutable|import|in|inout|interface|invariant|is|lazy|macro|mixin|module|new|nothrow|out|override|package|pragma|private|protected|public|pure|ref|return|scope|shared|static|struct|switch|synchronized|template|throw|try|typeid|typeof|union|unittest|version|while|with|__gshared|__traits|__vector|__parameters'
  special_keyword: '__FILE__|__FILE_FULL_PATH__|__MODULE__|__LINE__|__FUNCTION__|__PRETTY_FUNCTION__'
  special_token: '__DATE__|__EOF__|__TIME__|__TIMESTAMP__|__VENDOR__|__VERSION__'
  
  #basic_type: 'bool|byte|cdouble|cent|cfloat|char|creal|dchar|double|float|idouble|ifloat|int|ireal|long|real|short|ubyte|ucent|uint|ulong|ushort|void|wchar'
  #builtin_type_alias: 'string|dstring|wstring|size_t|ptrdiff_t|noreturn'
  #language_constant: 'null|true|false|__FILE__|__FILE_FULL_PATH__|__MODULE__|__LINE__|__FUNCTION__|__PRETTY_FUNCTION__|__ctfe'
  #language_variable: 'this|super'
  #reserved: '{{keyword}}|{{basic_type}}|{{language_constant}}|{{language_variable}}'
  
  traits_keyword: 'isArithmetic|isFloating|isIntegral|isScalar|isUnsigned|isStaticArray|isAssociativeArray|isAbstractClass|isFinalClass|isCopyable|isPOD|toType|isZeroInit|hasCopyConstructor|hasPostblit|getAliasThis|getPointerBitmap|getVirtualFunctions|getVirtualMethods|classInstanceSize|classInstanceAlignment|initSymbol|isDisabled|getVirtualIndex|isVirtualFunction|isVirtualMethod|isAbstractFunction|isFinalFunction|isOverrideFunction|isStaticFunction|isReturnOnStack|getFunctionVariadicStyle|getFunctionAttributes|isRef|getParameterStorageClasses|parameters|fullyQualifiedName|isNested|isFuture|isDeprecated|isTemplate|isModule|isPackage|hasMember|identifier|getAttributes|getBitfieldOffset|getBitfieldWidth|getLinkage|getLocation|getMember|getOverloads|getCppNamespaces|getVisibility|fullyQualifiedName|getProtection|getTargetInfo|getUnitTests|parent|child|allMembers|derivedMembers|isSame|compiles'
  pragma_identifier: 'crt_constructor|crt_destructor|inline|lib|linkerDirective|mangle|msg|printf|scanf|startaddress|LDC_alloca|LDC_allow_inline|LDC_extern_weak|LDC_global_crt_ctor|LDC_global_crt_dtor|LDC_inline_ir|LDC_intrinsic|LDC_never_inline|LDC_no_moduleinfo|LDC_no_typeinfo|LDC_va_start|LDC_va_arg|LDC_va_end|LDC_va_copy'
  
  operator_overloads: 'opUnary|opIndexUnary|opCast|opBinary|opBinaryRight|opEquals|opCmp|opCall|opAssign|opIndexAssign|opOpAssign|opIndexOpAssign|opSliceOpAssign|opIndex|opSlice|opDollar|opDispatch'
  
  #block_statement_loohahead: '(?={)'
  
  #exclamation_mark: '!(?!=|in\b|is\b)'

contexts:
  prototype:
    - include: comment-in
  
  main:
    - meta_include_prototype: false
    - match: ''
      set: [d, shebang]
  
  shebang:
    - meta_include_prototype: false
    - match: ^\#!
      scope: punctuation.definition.comment.d
      set: shebang-body
    - match: ^|(?=\S)  # Note: Ensure to highlight shebang if syntax is embedded.
      pop: 1
  
  shebang-body:
    - meta_include_prototype: false
    - meta_scope: comment.line.shebang.d
    - match: \bdmd|ldc2|gdc\b
      scope: constant.language.shebang.d
    - match: \n
      pop: 1
  
  d:
    - include: module-declaration
    - include: decl-defs
  
  module-declaration:
    - include: deprecated-attribute
    - include: user-defined-attribute
    - match: \bmodule\b
      scope: keyword.declaration.namespace.d
      push:
        - meta_scope: meta.namespace.d
        - match: '{{identifier}}(?=\s*(;|$))'
          scope: meta.path.d entity.name.namespace.d
        - match: '{{identifier}}'
          scope: meta.path.d variable.other.d
          push:
            - match: \.
              scope: meta.path.d punctuation.accessor.dot.d
              pop: true
            - include: not-whitespace-illegal-pop
        - include: expect-end-of-line
  
  decl-defs:
    #HexPrefix HexDigitsNoSingleUS? . HexDigitsNoStartingUS HexExponent
    - match: '({{hex_prefix}})((?:{{hex_digits_no_single_us}})?(\.)\h[\h_]*{{hex_exponent}})({{float_literal_suffix}})?'
      scope: meta.number.float.hexadecimal.d
      captures:
        1: constant.numeric.base.d
        2: constant.numeric.value.d
        3: punctuation.separator.decimal.d
        4: constant.numeric.suffix.d
    #HexPrefix HexDigitsNoSingleUS? HexExponent
    - match: '({{hex_prefix}})((?:{{hex_digits_no_single_us}})?{{hex_exponent}})({{float_literal_suffix}})?'
      scope: meta.number.float.hexadecimal.d
      captures:
        1: constant.numeric.base.d
        2: constant.numeric.value.d
        3: constant.numeric.suffix.d
    
    #LeadingDecimal . (DecimalDigitsNoStartingUS DecimalExponent?)?
    - match: '({{leading_decimal}}(\.)(?:\d[\d_]*(?:{{decimal_exponent}})?)?)({{float_literal_suffix}})?'
      scope: meta.number.float.decimal.d
      captures:
        1: constant.numeric.value.d
        2: punctuation.separator.decimal.d
        3: constant.numeric.suffix.d
    #. DecimalDigitsNoStartingUS DecimalExponent?
    - match: '((\.)\d[\d_]*(?:{{decimal_exponent}})?)({{float_literal_suffix}})?'
      scope: meta.number.float.decimal.d
      captures:
        1: constant.numeric.value.d
        2: punctuation.separator.decimal.d
        3: constant.numeric.suffix.d
    #LeadingDecimal DecimalExponent
    - match: '({{leading_decimal}}{{decimal_exponent}})({{float_literal_suffix}})?'
      scope: meta.number.float.decimal.d
      captures:
        1: constant.numeric.value.d
        2: constant.numeric.suffix.d
    #Integer FloatSuffix
    - match: '({{decimal_integer}})({{float_suffix}})'
      scope: meta.number.float.decimal.d
      captures:
        1: constant.numeric.value.d
        2: constant.numeric.suffix.d
    
    - match: '{{binary_integer}}({{integer_suffix}})?'
      scope: meta.number.integer.binary.d
      captures:
        1: constant.numeric.base.d
        2: constant.numeric.value.d
        3: constant.numeric.suffix.d
    - match: '{{hexadecimal_integer}}({{integer_suffix}})?'
      scope: meta.number.integer.hexadecimal.d
      captures:
        1: constant.numeric.base.d
        2: constant.numeric.value.d
        3: constant.numeric.suffix.d
    - match: '({{decimal_integer}})({{integer_suffix}})?'
      scope: meta.number.integer.decimal.d
      captures:
        1: constant.numeric.value.d
        2: constant.numeric.suffix.d
  
  assign-expression:
    - match: '\w+'
      set: closing-paren
  
  deprecated-attribute:
    - match: 'deprecated'
      scope: keyword.other.deprecated.d
      set:
        - match: '\('
          scope: punctuation.section.parens.begin.d
          set: assign-expression #NOTE TO SELF: TRY USING `branch` and `fail`!
        - match: ''
          pop: true
  
  user-defined-attribute:
    - match: '@'
      scope: punctuation.definition.annotation.begin.d
      set:
        - match: '{{identifier}}'
          scope: meta.path.d storage.type.d
          pop: true
          #TODO: add the rest of the grammar
  
  closing-paren:
    - match: '\)'
      scope: punctuation.section.parens.end.d
      pop: true
    - include: not-whitespace-illegal-pop
  
  not-whitespace-illegal:
    - match: '\S'
      scope: invalid.illegal.d
  not-whitespace-illegal-pop:
    - match: '\S'
      scope: invalid.illegal.d
      pop: true
  
  end-of-line-in:
    - match: ';'
      scope: punctuation.terminator.d
  end-of-line:
    - match: ';'
      scope: punctuation.terminator.d
      pop: true
  expect-end-of-line:
    - include: end-of-line
    - include: not-whitespace-illegal-pop
  maybe-end-of-line:
    - include: end-of-line
    - match: '(?=\S)'
      pop: true
  
  check-brackets-in:
    - match: '[\}\]\)]'
      scope: invalid.illegal.d
  
  meta-function:
    - meta_scope: meta.function.d
    - match: ''
      pop: true
  
  meta-function-parameters:
    - meta_scope: meta.function.parameters.d
    - match: ''
      pop: true
  
  meta-function-call:
    - meta_scope: meta.function-call.d
    - match: ''
      pop: true
  
  meta-function-call-template:
    - meta_scope: meta.function-call.template.d
    - match: ''
      pop: true
  
  meta-class:
    - meta_scope: meta.class.d
    - match: ''
      pop: true
  
  meta-interface:
    - meta_scope: meta.interface.d
    - match: ''
      pop: true
  
  meta-struct:
    - meta_scope: meta.struct.d
    - match: ''
      pop: true
  
  meta-union:
    - meta_scope: meta.union.d
    - match: ''
      pop: true
  
  meta-enum:
    - meta_scope: meta.enum.d
    - match: ''
      pop: true
